@@ -7,6 +7,14 @@
 
 #if defined(SWEET)
 #include <IOKit/IOPlatformExpert.h>
+
+/*
+ * The device's identity. The ADT carries a model (iPhone10,3) but no
+ * serial, so one is published here: a random Apple-style serial and a
+ * UUID, both fixed so they survive every reboot.
+ */
+#define SWEET_SERIAL_NUMBER  "F2LX9A1BJC6L"
+#define SWEET_PLATFORM_UUID  "3C1F4A8E-7B2D-4E55-9A61-2F0B6D8C41E7"
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
 
@@ -29,6 +37,19 @@
 	if (!IODTPlatformExpert::start(provider)) {
 		return false;
 	}
+	/*
+	 * The identity the platform device and the IORegistry look for: on this
+	 * service, on the nub it was started with and (in processTopLevel) on the
+	 * registry root, because each reader looks in a different place.
+	 */
+	setProperty("IOPlatformSerialNumber", SWEET_SERIAL_NUMBER);
+	setProperty("IOPlatformUUID", SWEET_PLATFORM_UUID);
+	if (provider != NULL) {
+		provider->setProperty("IOPlatformSerialNumber", SWEET_SERIAL_NUMBER);
+		provider->setProperty("IOPlatformUUID", SWEET_PLATFORM_UUID);
+	}
+	IOLog("SWEET: platform identity: serial %s, UUID %s\n",
+	    SWEET_SERIAL_NUMBER, SWEET_PLATFORM_UUID);
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
 	return true;
