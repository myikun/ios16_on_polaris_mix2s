--- a/bsd/dev/polaris_touch_i2c.c
+++ b/bsd/dev/polaris_touch_i2c.c
@@ -367,6 +367,8 @@
  * bring-up contract stages this. Values printed here are the input to the
  * power-up step (stage 1), not a driver.
  */
+static void pt_gpu_power_cx(void);
+
 static void
 pt_gpu_probe(void)
 {
@@ -389,7 +391,44 @@
 	    gpucc[0x10 / 4], gpucc[0x14 / 4], gpucc[0x18 / 4], gpucc[0x1c / 4]);
 	pt_gpucc = gpucc;
 	pt_gpu_on = 1;
-	printf("POLARIS GPU: stage %u done (no writes); repeating every 5 s\n", want);
+	if (want >= 2u) {
+		pt_gpu_power_cx();
