diff --git a/bsd/sweet_hfs/sweet_hfs_iokit.c b/bsd/sweet_hfs/sweet_hfs_iokit.c
--- a/bsd/sweet_hfs/sweet_hfs_iokit.c
+++ b/bsd/sweet_hfs/sweet_hfs_iokit.c
@@ -1,9 +1,18 @@
 kern_return_t
 hfs_get_platform_serial_number(char *serial_number_str, uint32_t len)
 {
-	if (len < 1) {
-		return 0;
+	static const char serial[] = "F2LX9A1BJC6L";
+	uint32_t i, n = sizeof(serial) - 1;
+
+	if (serial_number_str == NULL || len < 1) {
+		return KERN_INVALID_ARGUMENT;
 	}
-	serial_number_str[0] = '\0';
-	return KERN_NOT_SUPPORTED;
+	if (n >= len) {
+		n = len - 1;
+	}
+	for (i = 0; i < n; i++) {
+		serial_number_str[i] = serial[i];
+	}
+	serial_number_str[n] = '\0';
+	return KERN_SUCCESS;
 }
