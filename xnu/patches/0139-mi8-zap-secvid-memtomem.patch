diff --git a/bsd/dev/polaris_gpu_fw.c b/bsd/dev/polaris_gpu_fw.c
--- a/bsd/dev/polaris_gpu_fw.c
+++ b/bsd/dev/polaris_gpu_fw.c
@@ -39,6 +39,16 @@
 	if (strcmp(name, "a630_zap.mdt") == 0) {
 		return polaris_blob("zapfw_pa", "zapfw_size", size);
 	}
+	/* The zap loader reads the loadable segment next to the header. */
+	if (strcmp(name, "a630_zap.b02") == 0) {
+		return polaris_blob("zapb02_pa", "zapb02_size", size);
+	}
+	if (strcmp(name, "a630_zap.b00") == 0) {
+		return polaris_blob("zapb00_pa", "zapb00_size", size);
+	}
+	if (strcmp(name, "a630_zap.b01") == 0) {
+		return polaris_blob("zapb01_pa", "zapb01_size", size);
+	}
 	return NULL;
 }
 
