@@ -369,6 +369,7 @@
  */
 static void pt_gpu_power_cx(void);
 static void pt_gpu_gmu_survey(void);
+static void pt_gpu_gmu_firmware(void);
 
 static void
 pt_gpu_probe(void)
@@ -398,6 +399,9 @@
 	if (want >= 3u) {
 		pt_gpu_gmu_survey();
 	}
+	if (want >= 4u) {
