diff --git a/bsd/dev/polaris_touch_i2c.c b/bsd/dev/polaris_touch_i2c.c
--- a/bsd/dev/polaris_touch_i2c.c
+++ b/bsd/dev/polaris_touch_i2c.c
@@ -719,6 +719,21 @@
 			pt_gpucc[PT_GPUCC_SMMU_VOTE / 4] = vote | 1u;
 		}
 		printf("POLARIS GPU: stage 6 smmu_vote=%08x\n", pt_gpucc[PT_GPUCC_SMMU_VOTE / 4]);
+
+		/* The GPU block's bus-side clocks: Linux keeps these three always on. */
+		{
+			static const uint32_t off[3] = { 0x1170u, 0x1178u, 0x1204u };
+			static const char *name[3] = { "cb", "hub_aon", "hub_cx_int" };
+
+			for (int i = 0; i < 3; i++) {
+				uint32_t clk = g[off[i] / 4];
+
+				if ((clk & 1u) == 0u) {
+					g[off[i] / 4] = clk | 1u;
+				}
+				printf("POLARIS GPU: stage 6 %s=%08x\n", name[i], g[off[i] / 4]);
+			}
+		}
 		printf("POLARIS GPU: stage 6 waiting 8 s before the first SMMU read\n");
 		pt_wait(8000);
 		smmu = (volatile uint32_t *)ml_io_map(PT_SMMU_BASE, PT_SMMU_SIZE);
