@@ -1219,28 +1231,52 @@
 	}
 	for (uint32_t r = 0; r < G3D_REGIONS; r++) {
 		if (g3d_regions[r].phys != 0) {
+			printf("mi8gpu: gsA: %s uses a fixed physical address %#llx, nothing to allocate\n",
