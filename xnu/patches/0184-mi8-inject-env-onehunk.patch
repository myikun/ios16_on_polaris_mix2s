From: mi8 <mi8@local>
Subject: [PATCH] mi8-0184: the hakios injection before the envv terminator

One hunk, anchored on a comment that has been in exec_extract_strings all along.

---
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5827,6 +5827,30 @@
 		}
 	}
 
+	/*
+	 * mi8 0184: the injection hakios performs (xnu/hakios.patch, exec_inject_env).
+	 * Their kernel starts backboardd with the EAGL bridge in its environment, on this
+	 * same phone and this same userland, taking the program name from the path lookup
+	 * that resolved the executable rather than from the strings block.
+	 */
+	{
+		const char *nm = (imgp->ip_ndp != NULL) ? imgp->ip_ndp->ni_cnd.cn_nameptr : NULL;
+		size_t nl = (imgp->ip_ndp != NULL) ? imgp->ip_ndp->ni_cnd.cn_namelen : 0;
+
+		if (nm != NULL && nl == 10 && strncmp(nm, "backboardd", 10) == 0) {
+			char ins[128];
+
+			strlcpy(ins, "DYLD_INSERT_LIBRARIES=", sizeof(ins));
+			strlcat(ins, "/topaz/lib/libtopaz-inject.dylib", sizeof(ins));
+			if (exec_add_user_string(imgp, CAST_USER_ADDR_T(ins), UIO_SYSSPACE, TRUE) == 0 &&
+			    imgp->ip_argspace >= new_ptr_size) {
+				imgp->ip_argspace -= new_ptr_size;
+				imgp->ip_envc++;
+				printf("sweet: backboardd gets the GL bridge (hakios style)\n");
+			}
+		}
+	}
+
 	/* Save space for envv[] NULL terminator */
 	if (imgp->ip_argspace < new_ptr_size) {
 		error = E2BIG;
