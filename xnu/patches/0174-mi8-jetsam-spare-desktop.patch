diff --git a/bsd/kern/kern_memorystatus.c b/bsd/kern/kern_memorystatus.c
--- a/bsd/kern/kern_memorystatus.c
+++ b/bsd/kern/kern_memorystatus.c
@@ -4256,8 +4256,18 @@
 		 */
 		const char *comm = p->p_comm;
 
-		if (comm[0] == 't' && comm[1] == 'o' && comm[2] == 'p' && comm[3] == 'a' && comm[4] == 'z') {
-			printf("memorystatus: %s[%d] passed its footprint limit; kept (topaz)\n",
+		/*
+		 * The GPU work lives in these programs: topaz_test maps the buffers of a
+		 * test context, backboardd maps the window server's once CoreAnimation
+		 * draws through our GL library, and SpringBoard maps the ones it shares
+		 * with it. Their footprints are mostly IOKit mappings, so the small
+		 * limit a daemon is given is exceeded as soon as the first buffers are
+		 * mapped and the process dies in the middle of its first frame.
+		 */
+		if ((comm[0] == 't' && comm[1] == 'o' && comm[2] == 'p' && comm[3] == 'a' && comm[4] == 'z') ||
+		    (comm[0] == 'b' && comm[1] == 'a' && comm[2] == 'c' && comm[3] == 'k') ||
+		    (comm[0] == 'S' && comm[1] == 'p' && comm[2] == 'r' && comm[3] == 'i')) {
+			printf("memorystatus: %s[%d] passed its footprint limit; kept (GPU client)\n",
 			    comm, proc_getpid(p));
 			return;
 		}
