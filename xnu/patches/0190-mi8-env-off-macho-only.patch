From: mi8 <mi8@local>
Subject: [PATCH] mi8-0190: environment injection off, the Mach-O route alone

Test the binary's own LC_LOAD_DYLIB without the environment route interfering.

---
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5837,7 +5837,7 @@
 		const char *nm = (imgp->ip_ndp != NULL) ? imgp->ip_ndp->ni_cnd.cn_nameptr : NULL;
 		size_t nl = (imgp->ip_ndp != NULL) ? imgp->ip_ndp->ni_cnd.cn_namelen : 0;
 
-		if (nm != NULL && nl == 10 && strncmp(nm, "backboardd", 10) == 0) {
+		if (nm != NULL && nl == 11 && strncmp(nm, "backboardd", 11) == 0) {      /* mi8 0190: never matches */
 			char ins[128];
 
 			strlcpy(ins, "DYLD_INSERT_LIBRARIES=", sizeof(ins));
