diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -79,4 +79,726 @@
  * "compatible" string and "model" (D22AP / iPhone10,3 in the ADT), which
  * is what the iPhone userland (MobileGestalt) expects.
  */
+
+/*
+ * RedwoodGPU: the GPU as Mesa's freedreno asks for it.
+ *
+ * freedreno speaks Linux's DRM/msm ioctl ABI (drm-uapi/msm_drm.h) through a small
+ * libdrm stand-in that opens an IOService named RedwoodGPU and passes one structure
+ * per call as the call's data, with the answer expected in the same buffer. Buffers
+ * and command-stream arrays are user addresses inside that structure, so they are
+ * copied in with copyin().
+ */
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/copyio.h>   /* copyin() is a macro that checks __builtin_object_size */
+
+enum {
+	kMsmGemClose          = 0x09,
+	kMsmGetParam          = 0x40,
+	kMsmGemNew            = 0x42,
+	kMsmGemInfo           = 0x43,
+	kMsmGemCpuPrep        = 0x44,
+	kMsmGemCpuFini        = 0x45,
+	kMsmGemSubmit         = 0x46,
+	kMsmWaitFence         = 0x47,
+	kMsmSubmitqueueNew    = 0x48,
+	kMsmSubmitqueueClose  = 0x49,
+	kMsmSubmitqueueQuery  = 0x4a,
+};
+
+/* msm_drm.h, field for field */
+struct drm_msm_param {
+	uint32_t pipe;
+	uint32_t param;
+	uint64_t value;
+	uint32_t len;
+};
+
+struct drm_msm_gem_new {
+	uint64_t size;
+	uint32_t flags;
+	uint32_t handle;
+};
+
+struct drm_msm_gem_info {
+	uint32_t handle;
+	uint32_t flags;
+	uint64_t offset;
+};
+
+struct drm_msm_gem_cpu_prep {
+	uint32_t handle;
+	uint32_t op;
+	uint64_t timeout;
+};
+
+struct drm_msm_gem_cpu_fini {
+	uint32_t handle;
+};
+
+struct drm_msm_gem_submit_bo {
+	uint32_t flags;
+	uint32_t handle;
+	uint64_t presumed;
+};
+
+struct drm_msm_gem_submit_cmd {
+	uint32_t type;
+	uint32_t submit_idx;
+	uint32_t submit_offset;
+	uint32_t size;
+	uint32_t pad;
+	uint32_t nr_relocs;
+	uint64_t relocs;
+};
+
+struct drm_msm_gem_submit {
+	uint32_t flags;
+	uint32_t fence;
+	uint32_t nr_bos;
+	uint32_t nr_cmds;
+	uint64_t bos;
+	uint64_t cmds;
+	int32_t fence_fd;
+	uint32_t queueid;
+	uint64_t in_syncobjs;
+	uint64_t out_syncobjs;
+	uint32_t nr_in_syncobjs;
+	uint32_t nr_out_syncobjs;
+	uint32_t syncobj_stride;
+	uint32_t pad;
+};
+
+struct drm_msm_wait_fence {
+	uint32_t fence;
+	uint32_t flags;
+	uint64_t timeout;
+	uint32_t queueid;
+	uint32_t pad;
+};
+
+struct drm_msm_submitqueue {
+	uint32_t flags;
+	uint32_t prio;
+	uint32_t id;
+};
+
+struct drm_gem_close {
+	uint32_t handle;
+	uint32_t pad;
+};
+
+#define MSM_PARAM_GPU_ID        0x01
+#define MSM_PARAM_GMEM_SIZE     0x02
+#define MSM_PARAM_CHIP_ID       0x03
+#define MSM_PARAM_MAX_FREQ      0x04
+#define MSM_PARAM_NR_RINGS      0x05
+#define MSM_PARAM_PP_PGTABLE    0x06
+#define MSM_PARAM_FAULTS        0x07
+#define MSM_PARAM_SUSPENDS      0x08
+#define MSM_PARAM_PRIORITIES    0x09
+
+#define MSM_INFO_GET_OFFSET     0x00
+#define MSM_INFO_GET_IOVA       0x01
+
+#define MSM_BO_GPU_READONLY     0x00000002
+#define MSM_PREP_NOSYNC         0x04
+
+#define kRedwoodBuffers         64
+#define kRedwoodMaxCmds         32
+
+extern "C" {
+uint64_t mi8_gpu_address(uint64_t size);
+void mi8_gpu_address_free(uint64_t address, uint64_t size);
+bool mi8_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void mi8_gpu_unmap(uint64_t address, uint64_t size);
+void mi8_gpu_mapped(void);
+void mi8_gpu_to_memory(void *start, uint64_t size);
+bool mi8_gpu_done(uint32_t fence);
+uint32_t mi8_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+bool mi8_gpu_ready(void);
+}
+
+struct RedwoodBuffer {
+	IOBufferMemoryDescriptor *memory;
+	uint64_t gpu;
+	uint64_t size;
+	bool used;
+};
+
+class RedwoodGPU;
+
+class RedwoodGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(RedwoodGPUUserClient);
+
+	RedwoodBuffer buffers[kRedwoodBuffers];
+	unsigned calls;
+	unsigned submits;
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *ref) APPLE_KEXT_OVERRIDE;
+
+private:
+	RedwoodBuffer *buffer_by_handle(uint32_t handle);
+	RedwoodBuffer *buffer_add(uint64_t size, uint32_t flags, uint32_t *handle);
+	void buffer_drop(RedwoodBuffer *b);
+	void drop_all(void);
+	IOReturn do_submit(struct drm_msm_gem_submit *request);
+	IOReturn do_wait_fence(struct drm_msm_wait_fence *request);
+};
+
+class RedwoodGPU : public IOService {
+	OSDeclareDefaultStructors(RedwoodGPU);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RedwoodGPU, IOService);
+OSDefineMetaClassAndStructors(RedwoodGPUUserClient, IOUserClient);
+
+static void
+redwood_copy(void *dst, const void *src, size_t n)
+{
+	unsigned char *d = (unsigned char *)dst;
+	const unsigned char *s = (const unsigned char *)src;
+
+	while (n-- != 0) {
+		*d++ = *s++;
+	}
+}
+
+bool
+RedwoodGPU::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("RedwoodGPU: service published (msm ABI: params, buffers, submit, fences)\n");
+	return true;
+}
+
+IOReturn
+RedwoodGPU::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	RedwoodGPUUserClient *client = OSTypeAlloc(RedwoodGPUUserClient);
+
+	if (client == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!client->initWithTask(owningTask, securityID, type, properties) ||
+	    !client->attach(this) || !client->start(this)) {
+		client->release();
+		return kIOReturnNoMemory;
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+bool
+RedwoodGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	{
+		/*
+		 * Who is this? The test program, or the window server through the
+		 * injected GL library -- which is the thing we cannot see otherwise.
+		 */
+		pid_t who = 0;
+		char name[64] = "?";
+
+		if (pid_for_task(owningTask, &who) == KERN_SUCCESS) {
+			proc_name(who, name, sizeof(name));
+		}
+		IOLog("RedwoodGPU: opened by %s[%d]\n", name, (int)who);
+	}
+	for (unsigned i = 0; i < kRedwoodBuffers; i++) {
+		buffers[i].memory = NULL;
+		buffers[i].gpu = 0;
+		buffers[i].size = 0;
+		buffers[i].used = false;
+	}
+	calls = 0;
+	submits = 0;
+	return true;
+}
+
+RedwoodBuffer *
+RedwoodGPUUserClient::buffer_by_handle(uint32_t handle)
+{
+	if (handle == 0 || handle > kRedwoodBuffers) {
+		return NULL;
+	}
+	RedwoodBuffer *b = &buffers[handle - 1];
+	return b->used ? b : NULL;
+}
+
+void
+RedwoodGPUUserClient::buffer_drop(RedwoodBuffer *b)
+{
+	if (b == NULL || !b->used) {
+		return;
+	}
+	if (b->gpu != 0) {
+		mi8_gpu_unmap(b->gpu, b->size);
+		mi8_gpu_address_free(b->gpu, b->size);
+	}
+	if (b->memory != NULL) {
+		b->memory->release();
+	}
+	b->memory = NULL;
+	b->gpu = 0;
+	b->size = 0;
+	b->used = false;
+}
+
+void
+RedwoodGPUUserClient::drop_all(void)
+{
+	for (unsigned i = 0; i < kRedwoodBuffers; i++) {
+		buffer_drop(&buffers[i]);
+	}
+}
+
+RedwoodBuffer *
+RedwoodGPUUserClient::buffer_add(uint64_t size, uint32_t flags, uint32_t *handle)
+{
+	if (size == 0 || size > (1ull << 31)) {
+		return NULL;
+	}
+	uint32_t slot = 0;
+	while (slot < kRedwoodBuffers && buffers[slot].used) {
+		slot++;
+	}
+	if (slot == kRedwoodBuffers) {
+		IOLog("RedwoodGPU: all %u buffer slots are in use\n", (unsigned)kRedwoodBuffers);
+		return NULL;
+	}
+
+	vm_size_t bytes = (vm_size_t)((size + 0xfff) & ~(uint64_t)0xfff);
+	/*
+	 * withCapacity() adds kIOMemoryUnshared, and a buffer the kernel keeps to
+	 * itself cannot be mapped into the program: IOConnectMapMemory64 fails, Mesa
+	 * gets MAP_FAILED and writes into it. kIOMemoryKernelUserShared is what makes
+	 * clientMemoryForType() usable.
+	 */
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::withOptions(
+	    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous,
+	    bytes, PAGE_SIZE);
+	if (mem == NULL) {
+		IOLog("RedwoodGPU: cannot get %lu bytes for a buffer\n", (unsigned long)bytes);
+		return NULL;
+	}
+
+	uint64_t gpu = mi8_gpu_address(bytes);
+	if (gpu == 0) {
+		mem->release();
+		IOLog("RedwoodGPU: no GPU address for %lu bytes\n", (unsigned long)bytes);
+		return NULL;
+	}
+
+	IOPhysicalAddress phys = mem->getPhysicalAddress();
+	if (phys == 0) {
+		mi8_gpu_address_free(gpu, bytes);
+		mem->release();
+		IOLog("RedwoodGPU: buffer of %lu bytes has no physical address\n", (unsigned long)bytes);
+		return NULL;
+	}
+
+	uint64_t mapped = 0;
+	bool read_only = (flags & MSM_BO_GPU_READONLY) != 0;
+	for (; mapped < bytes; mapped += 0x1000) {
+		if (!mi8_gpu_map(gpu + mapped, (uint64_t)phys + mapped, read_only)) {
+			break;
+		}
+	}
+	if (mapped < bytes) {
+		for (uint64_t off = 0; off < mapped; off += 0x1000) {
+			mi8_gpu_unmap(gpu + off, 0x1000);
+		}
+		mi8_gpu_address_free(gpu, bytes);
+		mem->release();
+		IOLog("RedwoodGPU: cannot map %lu bytes at phys %#llx (stopped at %#llx)\n",
+		    (unsigned long)bytes, (uint64_t)phys, gpu + mapped);
+		return NULL;
+	}
+	mi8_gpu_mapped();
+
+	RedwoodBuffer *b = &buffers[slot];
+	b->memory = mem;
+	b->gpu = gpu;
+	b->size = bytes;
+	b->used = true;
+	*handle = slot + 1;
+	IOLog("RedwoodGPU: buffer %u: %lu bytes, phys %#llx, GPU address %#llx\n",
+	    *handle, (unsigned long)bytes, (uint64_t)phys, gpu);
+	return b;
+}
+
+IOReturn
+RedwoodGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	RedwoodBuffer *b = buffer_by_handle(type);
+
+	(void)options;
+	if (b == NULL || b->memory == NULL) {
+		IOLog("RedwoodGPU: map request for type %u: no such buffer\n", type);
+		return kIOReturnNoMemory;
+	}
+	if (calls < 64) {
+		IOLog("RedwoodGPU: map request for buffer %u (%llu bytes)\n", type, b->size);
+	}
+	b->memory->retain();
+	*memory = b->memory;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RedwoodGPUUserClient::clientClose(void)
+{
+	drop_all();
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RedwoodGPUUserClient::do_submit(struct drm_msm_gem_submit *request)
+{
+	struct drm_msm_gem_submit_bo bos[kRedwoodMaxCmds];
+	struct drm_msm_gem_submit_cmd cmds[kRedwoodMaxCmds];
+	uint64_t addresses[kRedwoodMaxCmds];
+	uint32_t words[kRedwoodMaxCmds];
+	unsigned n;
+
+	if (request->nr_cmds == 0 || request->nr_cmds > kRedwoodMaxCmds ||
+	    request->nr_bos == 0 || request->nr_bos > kRedwoodMaxCmds || false) {
+		IOLog("RedwoodGPU: submit with %u bos / %u cmds refused\n",
+		    request->nr_bos, request->nr_cmds);
+		return kIOReturnBadArgument;
+	}
+	if (copyin((user_addr_t)request->bos, bos,
+	    request->nr_bos * sizeof(struct drm_msm_gem_submit_bo)) != 0 ||
+	    copyin((user_addr_t)request->cmds, cmds,
+	    request->nr_cmds * sizeof(struct drm_msm_gem_submit_cmd)) != 0) {
+		IOLog("RedwoodGPU: submit: cannot read the descriptor arrays\n");
+		return kIOReturnBadArgument;
+	}
+
+	for (n = 0; n < request->nr_cmds; n++) {
+		struct drm_msm_gem_submit_cmd *cmd = &cmds[n];
+		RedwoodBuffer *b;
+
+		if (cmd->nr_relocs != 0) {
+			/* freedreno uses softpin here and should send none */
+			IOLog("RedwoodGPU: submit: command %u has %u relocations (not handled)\n",
+			    n, cmd->nr_relocs);
+			return kIOReturnUnsupported;
+		}
+		if (cmd->submit_idx >= request->nr_bos) {
+			IOLog("RedwoodGPU: submit: command %u names buffer %u of %u\n",
+			    n, cmd->submit_idx, request->nr_bos);
+			return kIOReturnBadArgument;
+		}
+		b = buffer_by_handle(bos[cmd->submit_idx].handle);
+		if (b == NULL) {
+			IOLog("RedwoodGPU: submit: command %u: buffer %u is unknown\n",
+			    n, bos[cmd->submit_idx].handle);
+			return kIOReturnNotFound;
+		}
+		if ((uint64_t)cmd->submit_offset + cmd->size > b->size) {
+			IOLog("RedwoodGPU: submit: command %u runs past its buffer (%u+%u > %llu)\n",
+			    n, cmd->submit_offset, cmd->size, b->size);
+			return kIOReturnBadArgument;
+		}
+		addresses[n] = b->gpu + cmd->submit_offset;
+		words[n] = cmd->size / 4;
+	}
+
+	uint32_t fence = mi8_gpu_submit(addresses, words, request->nr_cmds);
+	if (fence == 0) {
+		IOLog("RedwoodGPU: submit: the ring had no room\n");
+		return kIOReturnNoResources;
+	}
+	if (submits < 16) {
+		IOLog("RedwoodGPU: submit %u: %u command(s), fence %u\n", submits, request->nr_cmds, fence);
+	}
+	if (submits <= 4) {
+		/*
+		 * The biggest buffer is the framebuffer. Invalidate the cache over its
+		 * first line and print what is there: if the core drew the clear, these
+		 * words are the colour the program asked for.
+		 */
+		RedwoodBuffer *big = NULL;
+
+		for (unsigned i = 0; i < kRedwoodBuffers; i++) {
+			if (buffers[i].memory != NULL && (big == NULL || buffers[i].size > big->size)) {
+				big = &buffers[i];
+			}
+		}
+		if (big != NULL && big->memory->getBytesNoCopy() != NULL) {
+			volatile uint32_t *p = (volatile uint32_t *)big->memory->getBytesNoCopy();
+			vm_offset_t base = (vm_offset_t)p;
+
+			for (vm_offset_t a = base; a < base + 64; a += 64) {
+				__asm__ volatile ("dc ivac, %0" :: "r" (a) : "memory");
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			IOLog("RedwoodGPU: after submit %u, the %llu byte buffer at GPU %#llx has %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			    submits, big->size, big->gpu, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+		}
+	}
+	submits++;
+	request->fence = fence;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RedwoodGPUUserClient::do_wait_fence(struct drm_msm_wait_fence *request)
+{
+	uint64_t waited = 0;
+	uint64_t limit_ms = request->timeout == 0 ? 1000 : request->timeout / 1000000ull;
+
+	if (limit_ms == 0 || limit_ms > 5000) {
+		limit_ms = 5000;
+	}
+	while (!mi8_gpu_done(request->fence)) {
+		if (waited >= limit_ms) {
+			IOLog("RedwoodGPU: fence %u not reached after %llu ms\n", request->fence, waited);
+			return kIOReturnTimeout;
+		}
+		IOSleep(1);
+		waited++;
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RedwoodGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *ref)
+{
+	(void)dispatch;
+	(void)target;
+	(void)ref;
+
+	if (args == NULL) {
+		return kIOReturnBadArgument;
+	}
+
+	const void *in = args->structureInput;
+	size_t inSize = args->structureInputSize;
+	void *out = args->structureOutput;
+	size_t outSize = args->structureOutputSize;
+
+	if ((in == NULL || inSize == 0) && out != NULL) {
+		in = out;
+		inSize = outSize;
+	}
+	if (in == NULL || out == NULL || inSize == 0 || outSize == 0) {
+		return kIOReturnBadArgument;
+	}
+
+	if (calls < 48) {
+		IOLog("RedwoodGPU: call %u selector %#x in %lu out %lu\n",
+		    calls, selector, (unsigned long)inSize, (unsigned long)outSize);
+	}
+	calls++;
+
+	switch (selector) {
+	case kMsmGetParam: {
+		struct drm_msm_param request;
+
+		if (inSize < sizeof(request) || outSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		redwood_copy(&request, in, sizeof(request));
+		switch (request.param) {
+		case MSM_PARAM_GPU_ID:      request.value = 630; break;
+		case MSM_PARAM_GMEM_SIZE:   request.value = 0x80000; break;
+		case MSM_PARAM_CHIP_ID:     request.value = 0x06030001ull; break;
+		case MSM_PARAM_MAX_FREQ:    request.value = 710000000ull; break;
+		case MSM_PARAM_NR_RINGS:    request.value = 1; break;
+		case MSM_PARAM_PP_PGTABLE:  request.value = 0; break;
+		case MSM_PARAM_FAULTS:      request.value = 0; break;
+		case MSM_PARAM_SUSPENDS:    request.value = 0; break;
+		case MSM_PARAM_PRIORITIES:  request.value = 1; break;
+		default:                    request.value = 0; break;
+		}
+		request.len = sizeof(uint64_t);
+		redwood_copy(out, &request, sizeof(request));
+		return kIOReturnSuccess;
+	}
+
+	case kMsmGemNew: {
+		struct drm_msm_gem_new request;
+
+		if (inSize < sizeof(request) || outSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		redwood_copy(&request, in, sizeof(request));
+		if (buffer_add(request.size, request.flags, &request.handle) == NULL) {
+			return kIOReturnNoMemory;
+		}
+		redwood_copy(out, &request, sizeof(request));
+		return kIOReturnSuccess;
+	}
+
+	case kMsmGemInfo: {
+		struct drm_msm_gem_info request;
+		RedwoodBuffer *b;
+
+		if (inSize < sizeof(request) || outSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		redwood_copy(&request, in, sizeof(request));
+		b = buffer_by_handle(request.handle);
+		if (b == NULL) {
+			return kIOReturnNotFound;
+		}
+		request.offset = (request.flags == MSM_INFO_GET_IOVA) ? b->gpu : 0;
+		redwood_copy(out, &request, sizeof(request));
+		return kIOReturnSuccess;
+	}
+
+	case kMsmGemCpuPrep: {
+		struct drm_msm_gem_cpu_prep request;
+		RedwoodBuffer *b;
+
+		if (inSize < sizeof(request) || outSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		redwood_copy(&request, in, sizeof(request));
+		b = buffer_by_handle(request.handle);
+		if (b == NULL) {
+			return kIOReturnNotFound;
+		}
+		if ((request.op & MSM_PREP_NOSYNC) == 0) {
+			mi8_gpu_to_memory(b->memory->getBytesNoCopy(), b->size);
+		}
+		redwood_copy(out, &request, sizeof(request));
+		return kIOReturnSuccess;
+	}
+
+	case kMsmGemCpuFini: {
+		struct drm_msm_gem_cpu_fini request;
+
+		if (inSize < sizeof(request) || outSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		redwood_copy(&request, in, sizeof(request));
+		if (buffer_by_handle(request.handle) == NULL) {
+			return kIOReturnNotFound;
+		}
+		redwood_copy(out, &request, sizeof(request));
+		return kIOReturnSuccess;
+	}
+
+	case kMsmGemClose: {
+		struct drm_gem_close request;
+
+		if (inSize < sizeof(request) || outSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		redwood_copy(&request, in, sizeof(request));
+		buffer_drop(buffer_by_handle(request.handle));
+		redwood_copy(out, &request, sizeof(request));
+		return kIOReturnSuccess;
+	}
+
+	case kMsmSubmitqueueNew: {
+		struct drm_msm_submitqueue request;
+
+		if (inSize < sizeof(request) || outSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		redwood_copy(&request, in, sizeof(request));
+		request.id = 1;
+		redwood_copy(out, &request, sizeof(request));
+		IOLog("RedwoodGPU: submitqueue 1 (priority %u)\n", request.prio);
+		return kIOReturnSuccess;
+	}
+
+	case kMsmSubmitqueueClose:
+	case kMsmSubmitqueueQuery: {
+		if (outSize >= inSize) {
+			redwood_copy(out, in, inSize);
+		}
+		return kIOReturnSuccess;
+	}
+
+	case kMsmGemSubmit: {
+		struct drm_msm_gem_submit request;
+		IOReturn result;
+
+		if (inSize < sizeof(request) || outSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		redwood_copy(&request, in, sizeof(request));
+		result = do_submit(&request);
+		redwood_copy(out, &request, sizeof(request));
+		return result;
+	}
+
+	case kMsmWaitFence: {
+		struct drm_msm_wait_fence request;
+		IOReturn result;
+
+		if (inSize < sizeof(request) || outSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		redwood_copy(&request, in, sizeof(request));
+		result = do_wait_fence(&request);
+		redwood_copy(out, &request, sizeof(request));
+		return result;
+	}
+
+	default:
+		IOLog("RedwoodGPU: selector %#x is not one we answer\n", selector);
+		return kIOReturnUnsupported;
+	}
+}
+
+/* Called from bsd/dev/mi8_adreno.c, which is C: the symbol must be the C one. */
+extern "C" void
+RedwoodGPUStart(void)
+{
+	IOService *platform = IOService::getPlatform();
+	RedwoodGPU *gpu;
+
+	if (platform == NULL) {
+		IOLog("RedwoodGPU: no platform service\n");
+		return;
+	}
+	gpu = OSTypeAlloc(RedwoodGPU);
+	if (gpu == NULL) {
+		return;
+	}
+	if (!gpu->init() || !gpu->attach(platform)) {
+		gpu->release();
+		IOLog("RedwoodGPU: cannot attach\n");
+		return;
+	}
+	if (!gpu->start(platform)) {
+		gpu->detach(platform);
+		gpu->release();
+		IOLog("RedwoodGPU: did not start\n");
+		return;
+	}
+	gpu->release();
+}
