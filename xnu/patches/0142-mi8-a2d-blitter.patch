+/* Type-4 packet: write cnt registers starting at reg (odd parity, as the CP wants). */
+static uint32_t
+pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000u | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffffu) << 8) |
+	    (pm4_parity(reg) << 27);
+}
