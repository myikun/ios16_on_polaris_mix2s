+/*
+ * mi8 0175: DYLD_INSERT_LIBRARIES for the window server, added while the kernel builds
+ * the environment of the process it is about to exec. A wrapper around execv() can set
+ * the variable, but nothing guarantees launchd hands it on; the kernel's own copy is in
+ * the environment from the start. SpringBoard draws through backboardd, so backboardd is
+ * where CoreAnimation's GL renderer has to appear.
+ */
+static int sweet_glload_mx = 1;
+SYSCTL_INT(_kern, OID_AUTO, sweet_glload_mx, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_glload_mx, 0,
+    "DYLD_INSERT_LIBRARIES of the EAGL bridge's loader for the window server");
+#define SWEET_GLLOAD_MX_ENV "DYLD_INSERT_LIBRARIES=/topaz/lib/libtopaz-inject.dylib"
+/* dyld says what it maps, on the console instead of the window server's /dev/null */
+#define SWEET_DYLD_PRINT_ENV "DYLD_PRINT_LIBRARIES=1"
+#define SWEET_DYLD_TOFILE_ENV "DYLD_PRINT_TO_FILE=/dev/console"
 
 #if DEVELOPMENT || DEBUG
 static TUNABLE(bool, enable_dext_coredumps_on_panic, "dext_panic_coredump", true);
