+	/*
+	 * mi8 0175: the window server gets the EAGL bridge. Skipped when the caller
+	 * already named an inserted library (our wrapper does), so it cannot be
+	 * inserted twice, and skipped for anything that is not backboardd.
+	 */
+	if (sweet_glload_mx &&
+	    strnstr(imgp->ip_strings, "usr/libexec/backboardd", strlen(EXECUTABLE_KEY) + MAXPATHLEN) != NULL &&
+	    strnstr(imgp->ip_strings, "DYLD_INSERT_LIBRARIES=", strlen(EXECUTABLE_KEY) + MAXPATHLEN) == NULL) {
+		static const char *const extra[] = {
+			SWEET_GLLOAD_MX_ENV, SWEET_DYLD_PRINT_ENV, SWEET_DYLD_TOFILE_ENV
+		};
+
+		printf("sweet: backboardd is given the GL bridge (" SWEET_GLLOAD_MX_ENV ")\n");
+		for (unsigned i = 0; i < sizeof(extra) / sizeof(extra[0]); i++) {
+			error = exec_add_user_string(imgp, CAST_USER_ADDR_T(extra[i]), UIO_SYSSPACE, TRUE);
+			if (error) {
+				goto bad;
+			}
+			if (imgp->ip_argspace < new_ptr_size) {
+				error = E2BIG;
+				goto bad;
+			}
+			imgp->ip_argspace -= new_ptr_size;
+			imgp->ip_envc++;
+		}
+	}
