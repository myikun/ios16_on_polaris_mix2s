From: mi8 <mi8@local>
Subject: [PATCH] mi8-0182: inject the way hakios does

Their exec_inject_env (xnu/hakios.patch) reads the executable name from
imgp->ip_ndp->ni_cnd and adds one environment string; this port matched on
imgp->ip_strings and added three. Same device, same userland, working reference.

---
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5601,10 +5601,37 @@
  * Note:	The argument and environment vectors are user space pointers
  *		to arrays of user space pointers.
  */
+/*
+ * mi8 0182: the same injection hakios uses, which is known to work on this device
+ * (xnu/hakios.patch, exec_inject_env). The name comes from the path lookup that
+ * resolved the executable -- imgp->ip_ndp->ni_cnd -- and not from ip_strings, and
+ * one environment string is added rather than three.
+ */
+static bool
+mi8_exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	static const char library[] = "/topaz/lib/libtopaz-inject.dylib";
+	const char *name;
+	size_t namelen;
+
+	if (imgp->ip_ndp == NULL) {
+		return false;
+	}
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	namelen = imgp->ip_ndp->ni_cnd.cn_namelen;
+	if (name == NULL || namelen != 10 || strncmp(name, "backboardd", 10) != 0) {
+		return false;
+	}
+	strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	strlcat(env, library, size);
+	return true;
+}
+
 __attribute__((noinline))
 static int
 exec_extract_strings(struct image_params *imgp)
 {
+	char            mi8_inject_env[512];
 	int error = 0;
 	int     ptr_size = (imgp->ip_flags & IMGPF_WAS_64BIT_ADDR) ? 8 : 4;
 	int new_ptr_size = (imgp->ip_flags & IMGPF_IS_64BIT_ADDR) ? 8 : 4;
@@ -5779,52 +5806,26 @@
 	 * already named an inserted library (our wrapper does), so it cannot be
 	 * inserted twice, and skipped for anything that is not backboardd.
 	 */
-	if (sweet_glload_mx &&
-	    strnstr(imgp->ip_strings, "usr/libexec/backboardd", strlen(EXECUTABLE_KEY) + MAXPATHLEN) != NULL &&
-	    strnstr(imgp->ip_strings, "DYLD_INSERT_LIBRARIES=", strlen(EXECUTABLE_KEY) + MAXPATHLEN) == NULL) {
+	if (mi8_exec_inject_env(imgp, mi8_inject_env, sizeof(mi8_inject_env))) {
+		error = exec_add_user_string(imgp, CAST_USER_ADDR_T(mi8_inject_env), UIO_SYSSPACE, TRUE);
+		if (error) {
+			goto bad;
+		}
+		if (imgp->ip_argspace < new_ptr_size) {
+			error = E2BIG;
+			goto bad;
+		}
+		imgp->ip_argspace -= new_ptr_size;
+		imgp->ip_envc++;
+		printf("sweet: backboardd gets the GL bridge in its environment\n");
 		/*
-		 * dyld refuses DYLD_* for a platform binary unless the process looks
-		 * debuggable, and this port marks every binary on the root filesystem as
-		 * a platform binary. Set here, where the path above is already being read:
-		 * ip_csflags is handed to the process by proc_csflags_update() later, and
-		 * nothing clears this bit on the way.
+		 * The codesigning flags of 0177/0178/0180: dyld refuses DYLD_* for a
+		 * platform binary and library validation refuses a library that is only
+		 * ad-hoc signed, so both are cleared for this one program.
 		 */
 		imgp->ip_csflags |= CS_DEBUGGED;
-		/*
-		 * A platform binary carries CS_REQUIRE_LV, and library validation then
-		 * admits only libraries signed by Apple: the bridge in /topaz/lib is
-		 * ad-hoc signed, so dyld refuses it and the window server exits during
-		 * startup (seventeen execs, not one crash). Clear it for this one binary.
-		 */
 		imgp->ip_csflags &= ~CS_REQUIRE_LV;
-		/*
-		 * hakios (the reference port) lets dyld honour DYLD_INSERT_LIBRARIES by not
-		 * marking root-filesystem binaries as platform binaries at all; this port
-		 * does mark them (0035), and dyld throws every DYLD_* variable away for a
-		 * platform binary. Clear the flag for the window server only, so the
-		 * environment injected by 0175 reaches it.
-		 */
 		imgp->ip_csflags &= ~CS_PLATFORM_BINARY;
-		printf("sweet: backboardd is not a platform binary; dyld reads its environment\n");
-		printf("sweet: backboardd may load a library that is not Apple's\n");
-		printf("sweet: backboardd is marked debuggable so dyld takes its DYLD_* variables\n");
-		static const char *const extra[] = {
-			SWEET_GLLOAD_MX_ENV, SWEET_DYLD_PRINT_ENV, SWEET_DYLD_TOFILE_ENV
-		};
-
-		printf("sweet: backboardd is given the GL bridge (" SWEET_GLLOAD_MX_ENV ")\n");
-		for (unsigned i = 0; i < sizeof(extra) / sizeof(extra[0]); i++) {
-			error = exec_add_user_string(imgp, CAST_USER_ADDR_T(extra[i]), UIO_SYSSPACE, TRUE);
-			if (error) {
-				goto bad;
-			}
-			if (imgp->ip_argspace < new_ptr_size) {
-				error = E2BIG;
-				goto bad;
-			}
-			imgp->ip_argspace -= new_ptr_size;
-			imgp->ip_envc++;
-		}
 	}
 
 	/* Save space for envv[] NULL terminator */
