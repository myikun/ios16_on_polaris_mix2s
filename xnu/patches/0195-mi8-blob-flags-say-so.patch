From: mi8 <mi8@local>
Subject: [PATCH] mi8-0195b: strip the restrictive flags from the blob, no context

A one-line replacement: patch finds the line by its text, so the surroundings do not
matter.

---
diff --git a/bsd/kern/ubc_subr.c b/bsd/kern/ubc_subr.c
--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -3994,1 +3994,16 @@
-		blob->csb_flags = (ntohl(cd->flags) & CS_ALLOWED_MACHO) | CS_VALID;
+		/*
+		 * mi8 0195: the enforcement bits are not carried into the blob.
+		 * CS_RESTRICT makes dyld discard DYLD_* and CS_REQUIRE_LV makes library
+		 * validation refuse a library that is only ad-hoc signed; both come from
+		 * the signature of an Apple binary, so clearing them in kern_exec was
+		 * undone here on every exec. Platform marking stays: launchd expects it.
+		 */
+		{
+			static int said;
+
+			if (!said) {
+				said = 1;
+				printf("sweet: restrictive flags are stripped from code signing blobs (0195)\n");
+			}
+		}
+		blob->csb_flags = ((ntohl(cd->flags) & CS_ALLOWED_MACHO) | CS_VALID) &
+		    ~(CS_RESTRICT | CS_REQUIRE_LV | CS_HARD | CS_KILL | CS_ENFORCEMENT | CS_FORCED_LV);
