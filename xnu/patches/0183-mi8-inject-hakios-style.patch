From: mi8 <mi8@local>
Subject: [PATCH] mi8-0183: the hakios injection, inside the block 0180 added

Anchored on lines this project wrote itself, so it does not depend on context this
tree may not have.

---
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5806,6 +5806,30 @@
 		 */
 		imgp->ip_csflags &= ~CS_PLATFORM_BINARY;
 		printf("sweet: backboardd is not a platform binary; dyld reads its environment\n");
+		/*
+		 * The injection hakios performs (xnu/hakios.patch, exec_inject_env): the
+		 * program name comes from the path lookup that resolved the executable,
+		 * and one environment string is added. Their port runs this same userland
+		 * on this same phone, so this is the shape that is known to work.
+		 */
+		{
+			const char *nm = (imgp->ip_ndp != NULL) ? imgp->ip_ndp->ni_cnd.cn_nameptr : NULL;
+			size_t nl = (imgp->ip_ndp != NULL) ? imgp->ip_ndp->ni_cnd.cn_namelen : 0;
+
+			if (nm != NULL && nl == 10 && strncmp(nm, "backboardd", 10) == 0) {
+				char ins[128];
+
+				strlcpy(ins, "DYLD_INSERT_LIBRARIES=", sizeof(ins));
+				strlcat(ins, "/topaz/lib/libtopaz-inject.dylib", sizeof(ins));
+				if (exec_add_user_string(imgp, CAST_USER_ADDR_T(ins), UIO_SYSSPACE, TRUE) == 0) {
+					if (imgp->ip_argspace >= new_ptr_size) {
+						imgp->ip_argspace -= new_ptr_size;
+						imgp->ip_envc++;
+						printf("sweet: backboardd gets the GL bridge (hakios style)\n");
+					}
+				}
+			}
+		}
 		printf("sweet: backboardd may load a library that is not Apple's\n");
 		printf("sweet: backboardd is marked debuggable so dyld takes its DYLD_* variables\n");
 		static const char *const extra[] = {
