From: mi8 <mi8@local>
Subject: [PATCH] mi8-0191: the codesigning clears, where nothing switches them off

They were inside the block 0185 disabled, so the last builds had library validation
on and dyld refused the bridge.

---
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5744,6 +5744,24 @@
 
 	/* Note where the args ends and env begins. */
 	imgp->ip_endargv = imgp->ip_strendp;
+	/*
+	 * mi8 0191: the window server runs with these flags off, always.
+	 * CS_REQUIRE_LV makes dyld refuse a bridge that is only ad-hoc signed,
+	 * CS_PLATFORM_BINARY and CS_RESTRICT make it throw the environment away.
+	 * The clears used to live inside the block that 0185 turned off, so they
+	 * were not happening at all.
+	 */
+	if (imgp->ip_ndp != NULL) {
+		const char *nm = imgp->ip_ndp->ni_cnd.cn_nameptr;
+		size_t nl = imgp->ip_ndp->ni_cnd.cn_namelen;
+
+		if (nm != NULL && nl == 10 && strncmp(nm, "backboardd", 10) == 0) {
+			imgp->ip_csflags |= CS_DEBUGGED;
+			imgp->ip_csflags &= ~(CS_REQUIRE_LV | CS_PLATFORM_BINARY | CS_RESTRICT |
+			    CS_HARD | CS_KILL | CS_ENFORCEMENT | CS_FORCED_LV);
+			printf("sweet: backboardd runs without code signing restrictions (0191)\n");
+		}
+	}
 	imgp->ip_envc = 0;
 
 	/* Now, get the environment */
