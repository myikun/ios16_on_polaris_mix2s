+/*
+ * A-5 stage 0: read-only GPU clock/power state. Boot-arg polarisgpu=1.
+ *
+ * Only the GPUCC window is read. The 3D core registers at 0x5000000 are left
+ * alone: with CX/GX collapsed a read there can hang the bus, which is why the
+ * bring-up contract stages this. Values printed here are the input to the
+ * power-up step (stage 1), not a driver.
+ */
+static void
+pt_gpu_probe(void)
+{
+	uint32_t want = 0;
+	PE_parse_boot_argn("polarisgpu", &want, sizeof(want));
+	if (want == 0) {
+		return;
+	}
+	volatile uint32_t *gpucc = (volatile uint32_t *)ml_io_map(0x5090000u, 0x9000u);
+	if (gpucc == NULL) {
+		printf("POLARIS GPU: GPUCC map failed\n");
+		return;
+	}
+	printf("POLARIS GPU: a5 stage %u read-only, GPUCC=%p\n", want, (void *)gpucc);
+	printf("POLARIS GPU: gdsc cx=%08x gx=%08x cx_hw=%08x\n",
+	    gpucc[0x106c / 4], gpucc[0x100c / 4], gpucc[0x1540 / 4]);
+	printf("POLARIS GPU: rcg 0x00..0x0c %08x %08x %08x %08x\n",
+	    gpucc[0x00 / 4], gpucc[0x04 / 4], gpucc[0x08 / 4], gpucc[0x0c / 4]);
+	printf("POLARIS GPU: cfg 0x10..0x1c %08x %08x %08x %08x\n",
+	    gpucc[0x10 / 4], gpucc[0x14 / 4], gpucc[0x18 / 4], gpucc[0x1c / 4]);
+	printf("POLARIS GPU: stage %u done (no writes)\n", want);
+}
