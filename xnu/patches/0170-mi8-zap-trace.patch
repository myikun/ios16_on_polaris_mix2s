+/*
+ * A zap stage marker that is certain to be in the ring before the next stage runs:
+ * zap_load talks to TrustZone and writes physical memory, and a panic there leaves
+ * nothing else behind. mi8gpu_zap_only=N stops after stage N, for bisecting.
+ */
+static uint32_t zap_only_limit;
+
+static bool
+zap_mark(uint32_t stage, const char *what)
+{
+	printf("mi8gpu: [zap %u] %s\n", stage, what);
+	sleep_us(2000);
+	if (stage >= zap_only_limit) {
+		printf("mi8gpu: [zap] stopped after stage %u (mi8gpu_zap_only)\n", stage);
+		return true;
+	}
+	return false;
+}
