+/* A wait that gives up the processor: the busy form never returned for this thread. */
+static void
+gs_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, kMillisecondScale, &deadline);
+	assert_wait_deadline((event_t)gs_sleep_ms, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
