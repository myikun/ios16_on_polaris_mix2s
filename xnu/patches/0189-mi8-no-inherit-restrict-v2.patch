From: mi8 <mi8@local>
Subject: [PATCH] mi8-0189: do not inherit CS_RESTRICT, and say so

The same change as 0188 with one line of proof in the log.

---
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -1385,9 +1385,24 @@
 	 * requested them on exec.
 	 */
 	if (load_result.csflags & CS_VALID) {
+		/*
+		 * mi8 0189: CS_RESTRICT is not inherited. dyld discards every DYLD_*
+		 * variable for a process that carries it, and the signature of a
+		 * platform binary -- which this port marks all of its own as (0035) --
+		 * carries it. The hakios kernel never marks them, so it never has the
+		 * flag; leaving it out here is the same state.
+		 */
+		{
+			static int said;
+
+			if (!said) {
+				said = 1;
+				printf("sweet: CS_RESTRICT is not inherited (0189)\n");
+			}
+		}
 		imgp->ip_csflags |= load_result.csflags &
 		    (CS_VALID | CS_SIGNED | CS_DEV_CODE | CS_LINKER_SIGNED |
-		    CS_HARD | CS_KILL | CS_RESTRICT | CS_ENFORCEMENT | CS_REQUIRE_LV |
+		    CS_HARD | CS_KILL | CS_ENFORCEMENT | CS_REQUIRE_LV |
 		    CS_FORCED_LV | CS_ENTITLEMENTS_VALIDATED | CS_NO_UNTRUSTED_HELPERS | CS_RUNTIME |
 		    CS_ENTITLEMENT_FLAGS |
 		    CS_EXEC_SET_HARD | CS_EXEC_SET_KILL | CS_EXEC_SET_ENFORCEMENT);
