+/*
+ * The scaled present is the only per-pixel loop left in the display path:
+ * 998x2160 nearest-neighbour samples at 60 Hz. Precompute the destination
+ * column -> source column mapping once per swap rectangle so the inner loop
+ * is a table lookup instead of a 16.16 multiply plus two range tests.
+ */
+void
+AppleCLCD::buildXMap(int32_t sx, int32_t dx, int32_t w, int32_t px0, int32_t px1)
+{
+	uint64_t xstep = ((uint64_t)fLogicalW << 16) / fContentW;
+	uint64_t xpos = (uint64_t)(px0 - fOffX) * xstep;
+	int32_t i;
+
+	for (i = 0; i < px1 - px0; i++) {
+		int32_t lx = (int32_t)(xpos >> 16);
+		xpos += xstep;
+		if (lx < dx) {
+			lx = dx;
+		} else if (lx >= dx + w) {
+			lx = dx + w - 1;
+		}
+		fXMap[i] = (uint16_t)(sx + lx - dx);
+	}
+	fMapSx = sx;
+	fMapDx = dx;
+	fMapW = w;
+	fMapPx0 = px0;
+	fMapPx1 = px1;
+	fMapValid = true;
+}
